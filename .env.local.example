# Copy this file to .env.local and fill in your Supabase project values
# (Project Settings -> API in the Supabase dashboard)
#
# IMPORTANT: put your real values in .env.local, never in this file.
# .env.local is git-ignored; this .example file is not, so anything typed
# here would end up committed to the repo (including a secret that bypasses
# all database security).

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only, used by the cron route to bypass RLS when generating rent records.
# Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shared secret checked on the cron route so only Vercel Cron (or you, manually) can trigger it.
CRON_SECRET=choose-a-random-string
